<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 et avant : rien ne part dans la sauvegarde (adresse de la base avec mot de passe, notes). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
